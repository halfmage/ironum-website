---
// Announcement bar for the AI guides, ported from the LearnSlice header bar.
// Sits in the page flow above the sticky nav, so it scrolls away and the nav takes the top.
// Orange accent rather than the blue CTA color, so it never competes with the nav button.
// Clicks are measured by the ?ref= in the link (see translations), not by a script.
// TO REMOVE: delete this component and its <GuideBanner /> on src/pages/index.astro.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url)).guideBanner;
---

<a href={t.href} class="group block bg-orange-500 text-black hover:bg-orange-400 transition-colors duration-200 motion-reduce:transition-none">
  <span class="max-w-7xl mx-auto px-4 md:px-8 py-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-xs sm:text-sm">
    <span class="bg-black text-orange-500 text-[10px] font-bold tracking-[0.1em] uppercase px-2 py-0.5 rounded-full">{t.badge}</span>
    <span class="font-semibold sm:hidden">{t.textShort}</span>
    <span class="font-semibold hidden sm:inline">{t.text}</span>
    <span class="hidden sm:inline-flex items-center gap-1 font-bold">
      {t.cta}
      <span class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" aria-hidden="true">&rarr;</span>
    </span>
  </span>
</a>
