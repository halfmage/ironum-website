---
// Interactive "which route connects Jira to Copilot" check (EN/DE).
// All results are rendered at build time and shown with Alpine; nothing is stored or sent.
// When you re-verify the facts, update `checkedOn` and the result texts together.

export interface Props {
  locale?: 'en' | 'de';
  /** Show a link to the full article under the result (on the standalone page). */
  showArticleLink?: boolean;
  /** Show the eyebrow, heading and intro. Off on the standalone page, where the hero says the same. */
  showHeader?: boolean;
}

const { locale = 'en', showArticleLink = false, showHeader = true } = Astro.props;
const de = locale === 'de';

const checkedOn = new Date('2026-11-17T12:00:00Z');
const checkedOnText = checkedOn.toLocaleDateString(de ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const ms = de ? 'https://learn.microsoft.com/de-de' : 'https://learn.microsoft.com/en-us';
const links = {
  jiraCloud: { href: `${ms}/microsoft-365/copilot/connectors/jira-cloud-overview`, text: de ? 'Microsoft: Jira-Cloud-Connector' : 'Microsoft: Jira Cloud connector' },
  jiraDc: { href: `${ms}/microsoft-365/copilot/connectors/jira-data-center-overview`, text: de ? 'Microsoft: Jira-Data-Center-Connector' : 'Microsoft: Jira Data Center connector' },
  jiraDcDeploy: { href: `${ms}/microsoft-365/copilot/connectors/jira-data-center-deployment`, text: de ? 'Microsoft: Data-Center-Connector einrichten' : 'Microsoft: deploy the Data Center connector' },
  // These two pages change often; the German translation lags, so always link the English original.
  federated: { href: 'https://learn.microsoft.com/en-us/microsoft-365/copilot/connectors/federated-connectors-overview', text: de ? 'Microsoft: Live-Connectors (federated)' : 'Microsoft: federated connectors' },
  partners: { href: 'https://learn.microsoft.com/en-us/microsoft-365/copilot/connectors/connectors-gallery-partners', text: de ? 'Microsoft: Connectors von Partnern' : 'Microsoft: partner-built connectors' },
  mcpTools: { href: 'https://developer.atlassian.com/cloud/rovo-mcp/guides/supported-tools/', text: de ? 'Atlassian: Werkzeuge des MCP-Servers' : 'Atlassian: MCP server tools' },
  mcpOverview: { href: 'https://developer.atlassian.com/cloud/rovo-mcp/', text: de ? 'Atlassian: Rovo MCP Server' : 'Atlassian: Rovo MCP server' },
  studio: { href: 'https://microsoft.github.io/mcscatblog/posts/atlassian-jira-remote-mcp-copilot-studio/', text: de ? 'Microsoft: Atlassian MCP in Copilot Studio' : 'Microsoft: Atlassian MCP in Copilot Studio' },
  msGallery: { href: 'https://learn.microsoft.com/en-us/microsoft-365/copilot/connectors/connectors-gallery-microsoft', text: de ? 'Microsoft: eigene Connectors' : 'Microsoft-built connectors' },
  writeActions: { href: 'https://techcommunity.microsoft.com/blog/microsoft-copilot-blog/turn-copilot-insights-into-action-with-connector-write-capabilities/4571160', text: de ? 'Microsoft: Schreibaktionen (9. November 2026)' : 'Microsoft: write actions (9 November 2026)' },
  guide: { href: '/resources/guides/ai-for-product-owners/', text: de ? 'Leitfaden für Product Owner (Englisch)' : 'Free guide for product owners' },
};

const pilotHref = de ? '/de/dienstleistungen/jira-confluence-ki/' : '/services/jira-confluence-ai/';
const articleHref = de ? '/de/ressourcen/blog/copilot-jira-connector-was-er-liest/' : '/resources/blog/copilot-jira-connector-what-it-reads/';

type Tone = 'go' | 'limit' | 'pilot' | 'info';
interface Result {
  key: string;
  tone: Tone;
  title: string;
  points: string[];
  links?: { href: string; text: string }[];
  /** 'primary': pilot is the answer. 'secondary': pilot is an option if the free route falls short. */
  pilot?: 'primary' | 'secondary';
}

