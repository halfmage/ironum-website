        links: [links.jiraDc, links.jiraDcDeploy],
      },
      {
        key: 'dc-comments',
        tone: 'limit',
        title: 'Data Center comments: only on request',
        points: [
          "Microsoft's Data Center connector copies comments and attachments only after you request it from Microsoft Support. Do that before the rollout.",
          "Microsoft's catalog also lists connectors from other companies for Jira Data Center that index comments.",
          'The Atlassian Rovo connector works with Atlassian Cloud and does not help here.',
          'If you want the comments without a support request, our pilot tests your own system next to your Data Center in two weeks.',
        ],
        links: [links.jiraDc, links.partners],
        pilot: 'secondary',
      },
      {
        key: 'dc-write',
        tone: 'limit',
        title: 'Changing Data Center issues: we found no way',
        points: [
          "Microsoft's Data Center connector only reads. The Atlassian Rovo connector, which can create issues, works with Atlassian Cloud.",
          'We found no way documented by Microsoft or Atlassian for Copilot to create or update Data Center issues (as of November 2026).',
          'For answers from Jira, there is the Data Center connector. Our pilot also only answers; it does not change anything in Jira.',
        ],
        links: [links.jiraDc],
      },
      {
        key: 'dc-studio',
        tone: 'go',
        title: 'Use the Data Center connector in an agent',
        points: [
          'Without the Microsoft 365 Copilot add-on, Copilot Chat does not answer from Jira. An agent built in Copilot Studio can still use the Jira Data Center connector as its knowledge source.',
          "The connector needs the Microsoft Graph connector agent on a Windows machine in your network and Microsoft's plugin from the Atlassian Marketplace. Comments only on request via Microsoft Support.",
        ],
        links: [links.jiraDc, links.jiraDcDeploy],
      },
    ];

const toneStyle: Record<Tone, { box: string; badge: string; label: string }> = {
  go: { box: 'border-green-200 bg-green-50/60', badge: 'bg-green-600', label: de ? 'Geht mit vorhandenen Werkzeugen' : 'Works with what you have' },
  limit: { box: 'border-amber-200 bg-amber-50/60', badge: 'bg-amber-600', label: de ? 'Geht mit Einschränkungen' : 'Works with limits' },
  pilot: { box: 'border-blue-200 bg-blue-50/60', badge: 'bg-blue-600', label: de ? 'Braucht ein eigenes System' : 'Needs your own system' },
  info: { box: 'border-gray-200 bg-gray-50', badge: 'bg-gray-600', label: de ? 'Erst klären' : 'Check first' },
};
---

<section class="not-prose my-10 rounded-2xl border-2 border-gray-100 bg-white p-5 sm:p-8" x-data="jiraCopilotCheck()" aria-labelledby="jira-check-heading">
  {showHeader ? (
    <>
      <span class="text-orange-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase block">{text.eyebrow}</span>
      <h2 id="jira-check-heading" class="m-0 mt-2 text-2xl md:text-3xl font-bold text-black">{text.heading}</h2>
      <p class="m-0 mt-3 text-gray-600 text-lg leading-relaxed">{text.intro}</p>
    </>
  ) : (
    <h2 id="jira-check-heading" class="sr-only">{text.heading}</h2>
  )}

  <div class:list={['space-y-7', showHeader && 'mt-8']}>
    {text.questions.map((q, i) => (
      <fieldset>
        <legend class="text-base font-bold text-black mb-3"><span class="text-blue-600 mr-1">{i + 1}.</span> {q.label}</legend>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {q.options.map(([value, label]) => (
            <button
              type="button"
              class="text-left rounded-xl border-2 px-4 py-3 text-gray-700 font-medium transition-colors min-h-[48px] touch-manipulation"
              x-bind:class={`answers.${q.id} === '${value}' ? 'border-blue-600 bg-blue-50 text-black' : 'border-gray-100 hover:border-blue-200'`}
              x-bind:aria-pressed={`answers.${q.id} === '${value}' ? 'true' : 'false'`}
              x-on:click={`answers.${q.id} = '${value}'`}
            >{label}</button>
          ))}
        </div>
      </fieldset>
    ))}
  </div>

  <div class="mt-8" aria-live="polite">
    <p class="m-0 rounded-xl border-2 border-dashed border-gray-200 p-5 text-gray-500 font-medium" x-show="!result">{text.waiting}</p>

    {results.map((r) => {
      const style = toneStyle[r.tone];
      return (
        <div class:list={['rounded-2xl border-2 p-5 sm:p-6', style.box]} x-show={`result === '${r.key}'`} style="display: none">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500">{text.resultLabel}</span>
            <span class:list={['rounded-full px-3 py-1 text-xs font-bold text-white', style.badge]}>{style.label}</span>
          </div>
          <p class="m-0 mt-3 text-xl md:text-2xl font-bold text-black">{r.title}</p>
          <ul class="m-0 mt-4 list-none space-y-3 p-0">
            {r.points.map((p) => (
              <li class="m-0 flex items-start gap-3 text-gray-700 leading-relaxed">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-400" aria-hidden="true"></span>
                <span set:html={p} />
              </li>
            ))}
          </ul>
          {r.links && r.links.length > 0 && (
            <p class="m-0 mt-4 text-sm text-gray-500">
              {text.sources}:{' '}
              {r.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href} class="underline hover:text-blue-600" {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.text}</a>
                </>
              ))}
            </p>
          )}
          <div class="mt-5 flex flex-wrap gap-3">
            {r.pilot === 'primary' && (
              <>
                <a href={pilotHref} class="inline-block bg-blue-600 text-white rounded-full px-6 py-3 font-medium no-underline hover:bg-blue-700">{text.pilotPrimary}</a>
              </>
            )}
            {r.pilot === 'secondary' && (
              <a href={pilotHref} class="inline-block border-2 border-blue-600 text-blue-600 rounded-full px-6 py-2.5 font-medium no-underline hover:bg-blue-50">{text.pilotSecondary}</a>
            )}
            {showArticleLink && (
              <a href={articleHref} class="inline-block rounded-full px-2 py-3 font-medium text-blue-600 underline hover:text-blue-700">{text.article}</a>
            )}
          </div>
        </div>
      );
    })}

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="m-0 text-sm text-gray-500 max-w-2xl">{text.footnote}</p>
      <button type="button" class="text-sm font-semibold text-blue-600 underline hover:text-blue-700" x-show="answered" style="display: none" x-on:click="reset()">{text.reset}</button>
    </div>
  </div>
</section>

<script is:inline>
  // Defined before Alpine starts (Alpine loads as a deferred module).
  window.jiraCopilotCheck = function () {
    return {
      answers: { jira: null, licence: null, goal: null, data: null },
      get answered() {
        return Object.values(this.answers).some(Boolean);
      },
      reset() {
        this.answers = { jira: null, licence: null, goal: null, data: null };
      },
      get result() {
        const a = this.answers;
        if (!a.jira || !a.licence || !a.goal || !a.data) return null;
        if (a.data === 'own') return 'private';
        if (a.jira === 'unsure') return 'unsure-jira';
        if (a.jira === 'server') return 'server';
        if (a.licence === 'unsure') return 'unsure-licence';
        const dc = a.jira === 'dc';
        if (a.licence === 'none') return dc ? 'none-dc' : 'none-cloud';
        if (dc && a.goal === 'write') return 'dc-write';
        if (a.licence === 'studio') return dc ? 'dc-studio' : 'cloud-studio';
        if (a.goal === 'across') return dc ? 'across-dc' : 'across-cloud';
        return (dc ? 'dc-' : 'cloud-') + a.goal;
      },
    };
  };
</script>
