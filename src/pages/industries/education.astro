---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import PageHero from '../../components/sections/PageHero.astro';
import FAQSection from '../../components/sections/FAQSection.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Education', href: '/industries/education/' },
];

const faqItems = [
  {
    question: 'What is the LearnSlice AI Mentor and how does it work?',
    answer: 'The AI Mentor is our white-label intelligent tutoring solution built on RAG technology. It provides personalized learning paths, adaptive questioning, and instant feedback, all based on your specific curriculum content. It can be deployed for exam preparation, corporate training, or institutional education programs.',
  },
  {
    question: 'How does Ironum handle student data protection?',
    answer: 'Learner data is processed on infrastructure you choose: on-premise servers, hosting in Germany, or a dedicated Azure environment in EU regions. Learner data is not used to train third-party AI models. Data governance, transparency, and human oversight matter especially where a system falls under the high-risk education uses of the EU AI Act.',
  },
  {
    question: 'Can the AI Mentor be customized for IHK exam preparation?',
    answer: 'Yes. We have specific experience with IHK (Industrie- und Handelskammer) exam preparation content. The AI Mentor can be configured with your exam preparation content, practice questions, and the published competency frameworks to provide targeted preparation with adaptive difficulty levels.',
  },
  {
    question: 'Is there a white-label option for training companies?',
    answer: 'Yes. The AI Mentor is designed as a white-label solution. Training companies, educational publishers, and corporate L&D departments can deploy it under their own brand with custom styling, content, and domain-specific configurations.',
  },
  {
    question: 'What does the EU AI Act require for education AI?',
    answer: 'Annex III of the EU AI Act lists certain education uses as high-risk, for example AI that decides on admission, evaluates learning outcomes, or monitors students during tests. Not every learning tool falls under this. For high-risk systems, the obligations include risk management, data governance, technical documentation, transparency, and human oversight, and for providers a conformity assessment and registration. These rules apply from 2 December 2027. Fines for breaching high-risk obligations can reach EUR 15 million or 3% of worldwide annual turnover. Whether your system is high-risk is a legal question for your advisers; we provide the technical documentation.',
  },
];

const structuredData = [
  {
    "@type": "Service",
    "@id": "https://ironum.com/industries/education/#service",
    "name": "Education AI Solutions",
    "description": "Intelligent learning platforms with student data protection. White-label AI Mentor for exam preparation, corporate training, and institutional education.",
    "url": "https://ironum.com/industries/education/",
    "provider": { "@id": "https://ironum.com/#organization" },
    "areaServed": { "@type": "Place", "name": "Europe" },
    "serviceType": "AI Infrastructure for Education"
  },
  {
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": { "@type": "Answer", "text": item.answer }
    }))
  }
];
---

<Layout
  title="Education AI Solutions - Intelligent Learning, Protected by Design | Ironum"
  description="AI-powered learning platforms built for learner data protection. White-label AI Mentor for IHK exam prep, corporate training, and upskilling, with support for EU AI Act requirements."
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <Navigation />
  <PageHero
    eyebrow="AI FOR EDUCATION"
    title="Intelligent Learning, Protected by Design"
    subtitle="Deploy AI learning solutions on infrastructure you choose, hosted in Germany or on your own servers, with learner data under your control."
  />

  <!-- Challenges Section -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">The challenge</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-4">Education AI Needs High Standards</h2>
        <p class="text-gray-500 text-lg font-semibold mt-4 max-w-2xl mx-auto">The EU AI Act treats several education uses as high-risk, and learner data needs strong protection.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">High-Risk Classification</h3>
          <p class="text-gray-500">Annex III of the EU AI Act lists education uses such as admission decisions, grading, and test proctoring as high-risk. For these systems, it requires risk management, documentation, and human oversight from 2 December 2027.</p>
        </div>
        <div class="border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Learner Data Protection</h3>
          <p class="text-gray-500">Student performance data, learning patterns, and assessment results are highly sensitive personal data. Sending this to public cloud AI services without safeguards can conflict with GDPR principles and institutional data protection obligations.</p>
        </div>
        <div class="border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Content Quality Control</h3>
          <p class="text-gray-500">Generic AI generates generic content. Educational AI should answer from verified, curriculum-aligned material, which reduces the risk of wrong or invented answers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions Section -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">LearnSlice AI Mentor</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-4">White-Label AI Learning Solutions</h2>
        <p class="text-gray-500 text-lg font-semibold mt-4 max-w-2xl mx-auto">Built on our <a href="https://learnslice.com/" class="text-blue-600 underline">LearnSlice</a> AI Mentor platform, a white-label solution that educational institutions and training companies deploy under their own brand.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">IHK Exam Preparation</h3>
          <p class="text-gray-500">Adaptive AI tutoring for IHK certification exams. Personalized question paths, instant explanations, and progress tracking aligned with official competency frameworks.</p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Financial Literacy</h3>
          <p class="text-gray-500">AI-powered financial education modules for banks, insurers, and educational publishers. Interactive learning paths that adapt to individual knowledge levels.</p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">HR Onboarding</h3>
          <p class="text-gray-500">AI-guided onboarding programs that adapt to new hire roles, experience levels, and learning pace. Reduce time-to-productivity while ensuring consistent knowledge transfer.</p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Corporate Upskilling</h3>
          <p class="text-gray-500">Continuous learning platforms for workforce development. AI identifies skill gaps, recommends learning paths, and tracks competency development across your organization.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- See It in Action -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">See it in action</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-4">Built for Learners and Educators</h2>
        <p class="text-gray-500 text-lg font-semibold mt-4 max-w-2xl mx-auto">From personalised AI tutoring to structured quiz libraries, the LearnSlice AI Mentor adapts to every learning context.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="rounded-2xl overflow-hidden border-2 border-gray-100">
          <img src="/screenshots/learnslice.webp" alt="LearnSlice AI chat interface with IHK exam preparation, onboarding, company knowledge, and upskilling modes" class="w-full h-auto" loading="lazy" />
          <div class="p-6">
            <h3 class="text-lg font-bold mb-2">AI Learning Chat</h3>
            <p class="text-gray-500 text-sm">Learners choose their mode, ask questions, take quizzes, and get personalised feedback, hosted on European infrastructure.</p>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border-2 border-gray-100">
          <img src="/screenshots/fh-dortmund.webp" alt="LearnSlice quiz library with SCRUM, orientation, and logistics courses used at FH Dortmund" class="w-full h-auto" loading="lazy" />
          <div class="p-6">
            <h3 class="text-lg font-bold mb-2">Quiz Library Management</h3>
            <p class="text-gray-500 text-sm">Educators create, verify, and manage quiz content across departments with full control over curriculum alignment and quality.</p>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border-2 border-gray-100">
          <img src="/screenshots/financial-companion.webp" alt="Financial Companion AI interface for financial literacy education with health check and learning programme" class="w-full h-auto" loading="lazy" />
          <div class="p-6">
            <h3 class="text-lg font-bold mb-2">Financial Literacy Companion</h3>
            <p class="text-gray-500 text-sm">AI-powered financial education with health assessments and personalised learning programmes for banks and educational publishers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- On-Prem for Education -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">Data sovereignty</span>
          <h2 class="text-3xl md:text-5xl font-bold mt-4 mb-6">Student Data Stays on Your Infrastructure</h2>
          <p class="text-gray-500 text-lg font-semibold mb-6">AI Mentor deployments run on infrastructure you choose: on-premise servers, Hetzner in Germany, or a dedicated Azure environment in EU regions. Learner data is not used to train third-party AI models.</p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">On-premise deployment for schools and universities</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Technical documentation for EU AI Act requirements</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Data processing agreement (DPA) included</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600">Human oversight and transparency mechanisms built in</span>
            </li>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="border-2 border-gray-100 rounded-2xl p-6 text-center">
            <div class="text-blue-600 text-4xl font-bold mb-2">On-Prem</div>
            <p class="text-gray-500 text-sm font-semibold">for schools and universities</p>
          </div>
          <div class="border-2 border-gray-100 rounded-2xl p-6 text-center">
            <div class="text-blue-600 text-4xl font-bold mb-2">DE</div>
            <p class="text-gray-500 text-sm font-semibold">hosting in Germany with Hetzner</p>
          </div>
          <div class="border-2 border-gray-100 rounded-2xl p-6 text-center">
            <div class="text-blue-600 text-4xl font-bold mb-2">Docs</div>
            <p class="text-gray-500 text-sm font-semibold">technical documentation for the EU AI Act</p>
          </div>
          <div class="border-2 border-gray-100 rounded-2xl p-6 text-center">
            <div class="text-blue-600 text-4xl font-bold mb-2">DPA</div>
            <p class="text-gray-500 text-sm font-semibold">data processing agreement included</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto space-y-8">
      <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">RELATED SERVICES</span>
      <h2 class="text-3xl md:text-5xl font-bold">Solutions That Power Education AI</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/chatbot-interfaces/" class="border-2 border-gray-100 rounded-2xl p-8 bg-white hover:border-blue-200 transition-colors group">
          <h3 class="text-xl font-bold mb-3">Chatbot Interfaces</h3>
          <p class="text-gray-500 font-semibold mb-4">White-label AI tutoring assistants that provide personalized learning paths and instant feedback for students.</p>
          <span class="text-blue-600 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/services/llm-fine-tuning/" class="border-2 border-gray-100 rounded-2xl p-8 bg-white hover:border-blue-200 transition-colors group">
          <h3 class="text-xl font-bold mb-3">LLM Fine-Tuning</h3>
          <p class="text-gray-500 font-semibold mb-4">Train models on curriculum-specific content for responses aligned to your learning goals.</p>
          <span class="text-blue-600 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/services/workflow-automation/" class="border-2 border-gray-100 rounded-2xl p-8 bg-white hover:border-blue-200 transition-colors group">
          <h3 class="text-xl font-bold mb-3">Workflow Automation</h3>
          <p class="text-gray-500 font-semibold mb-4">Automate enrollment workflows, progress tracking, and administrative processes for educational institutions.</p>
          <span class="text-blue-600 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <FAQSection items={faqItems} />
  <aside class="max-w-4xl mx-auto px-4 sm:px-6 my-10 text-sm text-gray-600">
    <p class="rounded-xl border border-gray-200 bg-gray-50 px-6 py-4"><strong class="font-semibold text-gray-700">Note:</strong> This page is for general information only and does not constitute legal, tax, or data-protection advice. Ironum is a technical service provider, not a law firm. For an assessment of your specific situation, please consult your own qualified legal counsel or data protection officer.</p>
  </aside>
  <FinalCTA />
  <Footer />
</Layout>
