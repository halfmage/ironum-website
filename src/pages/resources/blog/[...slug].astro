---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => !post.data.draft && post.data.locale !== 'de')
    .map(post => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
// Posts that already answer their FAQ in the body don't get the FAQ block a second time.
const hasBodyFaq = headings.some(h => h.depth === 2 && /^(faq|frequently asked|häufige fragen)/i.test(h.text));
---

<BlogLayout frontmatter={{
  title: post.data.title,
  description: post.data.description,
  publishDate: post.data.publishDate.toISOString(),
  author: post.data.author,
  category: post.data.category,
  tags: post.data.tags,
  ogImage: post.data.ogImage,
  heroImage: post.data.heroImage,
  heroImageAlt: post.data.heroImageAlt,
  legalDisclaimer: post.data.legalDisclaimer,
  faq: post.data.faq,
  hasBodyFaq,
}}>
  <Content />
</BlogLayout>
