---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import PageHero from '../components/sections/PageHero.astro';
import Footer from '../components/Footer.astro';

// This page is the partner pitch Gerrit sends to IT system houses, MSPs and Atlassian partners.
// ?source=partner labels inquiries from here in Netlify Forms.
const partnerCta = '/contact/?source=partner#message-form';

const reasons = [
  {
    title: 'The demand is there',
    description: '57% of German companies with 20 or more employees now use AI, and its use for internal knowledge management doubled to 22% within a year. Among companies not using AI yet, 85% name missing technical know-how as a barrier.',
    source: { text: 'Bitkom, September 2026', href: 'https://www.bitkom.org/Presse/Presseinformation/Erstmals-nutzt-die-Mehrheit-der-Unternehmen-KI' },
  },
  {
    title: 'Hosting and operations stay with you',
    description: 'Our systems are self-hosted: in your data center or at your client. Hosting, operations and the support contract can stay with you instead of going to a US cloud service.',
  },
  {
    title: 'No AI team of your own needed',
    description: 'You do not have to hire and train AI engineers. We deliver with teams in Germany and Poland, and you stay the face to the client if you want to.',
  },
];

const models = [
  {
    label: 'Model 1',
    title: 'Referral',
    points: [
      'You introduce us to your client',
      'We handle the proposal, delivery and warranty',
      'You receive 10% of the net value of the first project',
      'Hosting and operations can stay with you',
    ],
  },
  {
    label: 'Model 2',
    title: 'White label',
    points: [
      'You sell under your name and invoice the client yourself',
      'We build as your engineering team in the background, at partner rates',
      'You keep the full client relationship',
      'Terms are agreed in writing per project',
    ],
  },
];

const steps = [
  { number: '01', title: 'Get to know each other', description: '30 minutes: your clients, your infrastructure, which AI requests you are getting right now.' },
  { number: '02', title: 'Choose the model', description: 'Referral or white label, agreed in writing, with an NDA.' },
  { number: '03', title: 'First client', description: 'We join your first client conversation as your AI team and start with the pilot.' },
];

const check = 'M5 13l4 4L19 7';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Partners', href: '/partners' },
];
---

<Layout
  title="AI Partner for IT System Houses, MSPs and Atlassian Partners | Ironum"
  description="Your clients ask about AI and you have no AI team. Ironum builds self-hosted AI for your clients: by referral with a 10% fee, or white label under your name."
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <PageHero
    eyebrow="FOR IT SYSTEM HOUSES, MSPs AND ATLASSIAN PARTNERS"
    title="Your Clients Ask About AI. We Build It."
    subtitle="Ironum is the AI engineering team for IT service providers: you bring the client relationship and the infrastructure, we bring a ready offer and engineers who take it into production."
    ctaText="Request a partner call"
    ctaLink={partnerCta}
  />

  <!-- Why -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="max-w-3xl space-y-4">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">WHY IT FITS</span>
        <h2 class="text-3xl md:text-5xl font-bold">AI Projects Without an AI Team</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {reasons.map((r) => (
          <div class="border-2 border-gray-100 rounded-2xl p-6 md:p-8 flex flex-col">
            <h3 class="text-2xl font-bold mb-3">{r.title}</h3>
            <p class="text-gray-500 text-lg font-semibold">{r.description}</p>
            {r.source && <p class="text-gray-400 text-sm font-semibold mt-4">Source: <a href={r.source.href} target="_blank" rel="noopener" class="underline">{r.source.text}</a></p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Models -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="max-w-3xl space-y-4">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">WORKING TOGETHER</span>
        <h2 class="text-3xl md:text-5xl font-bold">Two Models, Chosen per Client</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {models.map((m) => (
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-6 md:p-8">
            <span class="text-blue-600 text-sm font-bold uppercase tracking-wider">{m.label}</span>
            <h3 class="text-3xl font-bold mt-2 mb-6">{m.title}</h3>
            <ul class="space-y-3">
              {m.points.map((p) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-green-500 mt-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} /></svg>
                  <span class="text-gray-700 text-lg font-medium">{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Offer -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-start">
      <div class="space-y-4">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">WHAT YOU CAN OFFER</span>
        <h2 class="text-3xl md:text-5xl font-bold">An Entry Point Clients Can Say Yes To</h2>
        <p class="text-gray-500 text-lg font-semibold">A clearly scoped pilot at a fixed price lowers the barrier for the client. Production follows, also at a fixed price.</p>
        <p class="text-gray-500 text-lg font-semibold">Beyond that we build private document search, AI assistants and workflow automation, always on infrastructure you or your client control.</p>
      </div>
      <a href="/services/jira-confluence-ai/" class="block border-2 border-blue-600 rounded-2xl p-6 md:p-8 hover:bg-gray-50 transition-colors no-underline">
        <p class="text-sm font-bold uppercase tracking-wider text-gray-500">Pilot · 2 weeks · €4,900 plus VAT</p>
        <h3 class="text-2xl md:text-3xl font-bold mt-2 mb-3 text-gray-900">AI search for Jira and Confluence, on the client's servers</h3>
        <p class="text-gray-500 text-lg font-semibold">For clients on Atlassian Data Center, where Rovo is not an option without a Cloud plan. With permissions, source links and a written assessment after two weeks.</p>
        <span class="inline-block mt-4 text-blue-600 font-semibold">See the offer →</span>
      </a>
    </div>
  </section>

  <!-- Steps and contact -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-5 gap-12 items-start">
      <div class="lg:col-span-3 space-y-8">
        <div class="space-y-4">
          <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">HOW WE START</span>
          <h2 class="text-3xl md:text-5xl font-bold">Three Steps to the First Joint Client</h2>
        </div>
        <div class="space-y-6">
          {steps.map((s) => (
            <div class="flex gap-5">
              <span class="text-blue-600 text-2xl font-bold shrink-0 w-10">{s.number}</span>
              <div>
                <h3 class="text-xl font-bold mb-1">{s.title}</h3>
                <p class="text-gray-500 text-lg font-semibold">{s.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="lg:col-span-2 bg-white border-2 border-gray-100 rounded-2xl p-6 md:p-8 space-y-4">
        <img src="/gerrit-halfmann.jpg" alt="Gerrit Halfmann, founder of Ironum" width="2296" height="2296" class="w-24 h-24 rounded-2xl object-cover" loading="lazy" />
        <div>
          <p class="text-xl font-bold">Gerrit Halfmann</p>
          <p class="text-gray-500 font-semibold">Founder, Ironum</p>
        </div>
        <p class="text-gray-700 font-medium">Ironum is a product of LearnSlice UG (haftungsbeschränkt), Düsseldorf. Our team brings more than 20 years of experience in custom software engineering.</p>
        <p class="text-gray-500 font-semibold"><a href="mailto:info@ironum.com" class="text-blue-600 hover:underline">info@ironum.com</a> · <a href="tel:+4915758539892" class="text-blue-600 hover:underline">+49 157 585 39892</a></p>
        <a href={partnerCta} class="inline-block w-full text-center bg-blue-600 text-white rounded-full px-6 py-3 font-medium text-lg hover:bg-blue-700 transition-all duration-200 min-h-[48px] touch-manipulation">Request a partner call</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
