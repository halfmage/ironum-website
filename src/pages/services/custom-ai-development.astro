---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import FAQSection from '../../components/sections/FAQSection.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import RelatedReading from '../../components/sections/RelatedReading.astro';
import Footer from '../../components/Footer.astro';

const capabilities = [
  {
    title: 'Private RAG & Knowledge Search',
    description: 'Search across all your documents in natural language, with answers grounded in your data and nothing sent to public AI tools.',
    href: '/services/enterprise-rag/',
    icon: 'M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z',
  },
  {
    title: 'AI Assistants & Chatbots',
    description: 'Branded, multi-channel assistants that know your business, deployed on your website, Teams, Slack, or WhatsApp.',
    href: '/services/chatbot-interfaces/',
    icon: 'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z',
  },
  {
    title: 'Custom & Fine-Tuned Models',
    description: 'Open-source models fine-tuned on your proprietary data for domain-specific behavior. Your model, your servers, no per-query fees.',
    href: '/services/llm-fine-tuning/',
    icon: 'M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z',
  },
  {
    title: 'Workflow Automation & Agents',
    description: 'Automate manual processes and connect 400+ tools with self-hosted, open-source workflows. No vendor lock-in.',
    href: '/services/workflow-automation/',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    title: 'AI Strategy & Audits',
    description: 'Not sure where to start? We find exactly where AI saves you time and money, and what it takes to ship it.',
    href: '/services/ai-consulting/',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
];

const faqItems = [
  {
    question: 'What does "custom AI development" actually mean at Ironum?',
    answer: 'We build production AI systems tailored to your data and processes: private RAG and knowledge search, AI assistants and chatbots, fine-tuned open-source models, and automated workflows and agents. Everything runs on infrastructure you control, and you keep the code and models we build. We are software developers who build AI solutions, not a SaaS you rent.',
  },
  {
    question: 'Can you build custom AI on our own servers or cloud?',
    answer: 'Yes. We deploy on your infrastructure, your cloud account (Azure EU, your own AWS/GCP), German-hosted Hetzner, or fully on-premises. With open-source models the entire pipeline runs on your hardware, so your data is never sent to third-party model providers. That is the default, not an add-on.',
  },
  {
    question: 'How can a European team be competitive on price?',
    answer: 'Our engineering teams work across Germany and Poland. You get German engineering and project standards at nearshore rates, in EU time zones and under EU contracts. For US companies that means a partner who is cost-competitive with offshore options while keeping data inside trusted EU jurisdiction.',
  },
  {
    question: 'Do we own the code and the model?',
    answer: 'Yes. We build on open-source foundations (Llama, Mistral, n8n, Qdrant and others) and hand over the code and model artifacts. No black boxes and no vendor lock-in. You can run, extend, or move the system without depending on us.',
  },
  {
    question: 'How do you prove you can deliver?',
    answer: 'Through real work, not slideware. Our team brings more than 20 years of custom software engineering, and we have shipped production AI for FH Dortmund, Smella, and LearnSlice. We start most engagements with a working proof-of-concept on your actual data within about two weeks, so you see results before committing to a full build.',
  },
  {
    question: 'Is the work GDPR and EU AI Act compliant?',
    answer: 'When you need it, yes. EU data residency, a standard Data Processing Agreement, audit logging, and EU AI Act documentation are available on every build. We treat compliance as a capability you can switch on, not the only reason to hire us.',
  },
];

const structuredData = [
  {
    "@type": "Service",
    "@id": "https://ironum.com/services/custom-ai-development/#service",
    "name": "Custom AI Development",
    "description": "Custom AI software development: private RAG, AI assistants, fine-tuned models, and automation built on infrastructure you control. German and Polish engineering, competitive nearshore pricing, for US and EU companies.",
    "provider": { "@id": "https://ironum.com/#organization" },
    "areaServed": [
      { "@type": "Place", "name": "Europe" },
      { "@type": "Place", "name": "United States" }
    ],
    "serviceType": "Custom AI Development"
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Custom AI Development', href: '/services/custom-ai-development' },
];
---

<Layout
  title="Custom AI Development & Private RAG | US & EU | Ironum"
  description="Trustworthy custom AI development: private RAG, assistants, and models on infrastructure you control. German + Polish engineering, competitive nearshore rates."
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <Navigation />

  <PageHero
    eyebrow="CUSTOM AI DEVELOPMENT"
    title="Custom AI Development You Can Trust"
    subtitle="We are a team with more than 20 years in custom software engineering. We build private RAG, AI assistants, and custom models on infrastructure you control, for companies in the US and EU. Your data stays yours."
    ctaText="Scope my AI project"
    ctaLink="/contact/?source=custom-ai-development"
  />

  <TrustBar title="Built on open-source, enterprise-grade technology" />

  <!-- What we build -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">What We Build</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-4">One Team for the AI You Need to Ship</h2>
        <p class="text-gray-500 text-lg font-semibold mt-4 max-w-2xl mx-auto">Hire developers who build the whole system, not a tool you have to assemble yourself. We bundle these capabilities into a single custom build, scoped to your problem.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {capabilities.map((c) => (
          <a href={c.href} class="border-2 border-gray-100 rounded-2xl p-8 hover:border-blue-200 hover:shadow-lg transition-all duration-200 group block">
            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-100 transition-colors">
              <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">{c.title}</h3>
            <p class="text-gray-500 text-lg font-semibold">{c.description}</p>
            <span class="inline-flex items-center text-blue-600 font-semibold mt-4 group-hover:gap-2 transition-all">
              Learn more
              <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Ironum: 4 pillars -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">Why Ironum</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-4">Two Decades of Engineering, Now Applied to AI</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold mb-3">Your data stays yours</h3>
          <p class="text-gray-500 text-lg font-semibold">Every system runs on infrastructure you control. With open-source models, nothing is sent to third-party providers, no leakage, no training on your data, no lock-in.</p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold mb-3">Competitive nearshore pricing</h3>
          <p class="text-gray-500 text-lg font-semibold">German engineering standards delivered by teams in Germany and Poland, at nearshore rates. Cost-competitive with offshore options, in EU time zones, under EU contracts.</p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold mb-3">Proven by real work</h3>
          <p class="text-gray-500 text-lg font-semibold">More than 20 years building custom software, now applied to AI. We have shipped production systems for FH Dortmund, Smella, and LearnSlice. Built by engineers, not PowerPoint.</p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold mb-3">Compliance when you need it</h3>
          <p class="text-gray-500 text-lg font-semibold">EU data residency, GDPR Data Processing Agreements, audit logging, and EU AI Act documentation available on every build, ready for US companies serving EU customers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">Selected Work</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-4">Where We Have Delivered</h2>
        <p class="text-gray-500 text-lg font-semibold mt-4 max-w-2xl mx-auto">A few of the production systems we have built. Each one started as a custom engineering problem, not a template.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <a href="/services/llm-fine-tuning/" class="border-2 border-gray-100 rounded-2xl p-8 hover:border-blue-200 transition-colors group block">
          <span class="text-orange-500 font-semibold text-sm uppercase tracking-wider">Education</span>
          <h3 class="text-xl font-bold mt-2 mb-3">FH Dortmund</h3>
          <p class="text-gray-500 text-lg font-semibold">An adaptive, quiz-based AI learning platform built with the university. Faculty reported stronger student motivation and exam outcomes.</p>
        </a>
        <a href="/services/chatbot-interfaces/" class="border-2 border-gray-100 rounded-2xl p-8 hover:border-blue-200 transition-colors group block">
          <span class="text-orange-500 font-semibold text-sm uppercase tracking-wider">EdTech</span>
          <h3 class="text-xl font-bold mt-2 mb-3">LearnSlice</h3>
          <p class="text-gray-500 text-lg font-semibold">Sovereign AI personalization where student profiles never leave the platform's control. No data sent to US clouds.</p>
        </a>
        <a href="/services/geo-optimization/" class="border-2 border-gray-100 rounded-2xl p-8 hover:border-blue-200 transition-colors group block">
          <span class="text-orange-500 font-semibold text-sm uppercase tracking-wider">Visibility</span>
          <h3 class="text-xl font-bold mt-2 mb-3">Smella</h3>
          <p class="text-gray-500 text-lg font-semibold">A structured-data and GEO build that got the brand recommended by AI answer engines alongside its competitors within weeks.</p>
        </a>
      </div>
    </div>
  </section>

  <ProcessSteps
    eyebrow="HOW IT WORKS"
    title="From First Call to Production"
    steps={[
      { number: "01", title: "Discovery & Scope", description: "A free call to map your data, infrastructure, and goals. We come back with a clear scope, timeline, and fixed price." },
      { number: "02", title: "Proof of Concept", description: "A working prototype on your actual data, deployed in your environment in about two weeks. You see results before the full build." },
      { number: "03", title: "Production & Handover", description: "Full rollout with monitoring, documentation, and training. You own the code and models. Ongoing support if you want it." }
    ]}
  />

  <!-- Pricing signal -->
  <section class="px-4 md:px-20 pb-20 md:pb-32">
    <div class="max-w-7xl mx-auto">
      <div class="bg-black rounded-2xl p-8 md:p-16 text-center">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase">Pricing</span>
        <h2 class="text-white text-3xl md:text-5xl font-bold mt-4">Fixed Scope. Transparent Price.</h2>
        <p class="text-white/80 text-lg md:text-xl font-medium mt-4 max-w-3xl mx-auto">Most projects start with a focused proof-of-concept, then a fixed-price production build. Because our teams are in Germany and Poland, you get senior EU engineering at rates that stay competitive with offshore, without sending your data offshore.</p>
        <a href="/contact/?source=custom-ai-development-pricing"
          class="inline-block bg-blue-600 text-white rounded-full px-6 py-3 font-medium text-lg hover:bg-blue-700 transition-all duration-200 min-h-[48px] touch-manipulation mt-8">
          Get a scoped quote →
        </a>
      </div>
    </div>
  </section>

  <FAQSection items={faqItems} />

  <RelatedReading
    eyebrow="FURTHER READING"
    heading="Further Reading"
    cta="Read article"
    links={[
      {
        href: '/resources/blog/enterprise-rag-explained/',
        title: 'Enterprise RAG Explained',
        description: 'A non-technical guide to Retrieval-Augmented Generation: what it is, why it matters, and how to evaluate RAG solutions for your business.',
      },
      {
        href: '/resources/blog/chatbot-own-data-gdpr-sme/',
        title: 'Chatbot on Your Own Data',
        description: 'How companies put a RAG chatbot into production on their own data, GDPR-compliant, within four weeks.',
      },
      {
        href: '/resources/blog/gdpr-compliant-ai-guide/',
        title: 'GDPR-Compliant AI: A Guide',
        description: 'How to deploy AI that meets GDPR and EU AI Act requirements without sending data to third-party providers.',
      },
    ]}
  />
  <FinalCTA />
  <Footer />
</Layout>
