---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Footer from '../../components/Footer.astro';

// Diese Seite ist der Partner-Pitch, den Gerrit an Systemhäuser, MSPs und Atlassian-Partner schickt.
// ?source=partner kennzeichnet Anfragen von hier in Netlify Forms.
const partnerCta = '/de/kontakt/?source=partner#message-form';

const reasons = [
  {
    title: 'Die Nachfrage ist da',
    description: '57 % der Unternehmen ab 20 Beschäftigten in Deutschland nutzen inzwischen KI, und der Einsatz im internen Wissensmanagement hat sich binnen eines Jahres auf 22 % verdoppelt. Unter denen, die noch keine KI nutzen, nennen 85 % fehlendes technisches Know-how für die Umsetzung als Hürde.',
    source: { text: 'Bitkom, September 2026', href: 'https://www.bitkom.org/Presse/Presseinformation/Erstmals-nutzt-die-Mehrheit-der-Unternehmen-KI' },
  },
  {
    title: 'Betrieb und Hosting bleiben bei Ihnen',
    description: 'Unsere Systeme laufen selbst gehostet: in Ihrem Rechenzentrum oder beim Kunden. Hosting, Betrieb und Supportvertrag können bei Ihnen liegen, statt an einen US-Cloud-Dienst zu gehen.',
  },
  {
    title: 'Kein eigenes KI-Team nötig',
    description: 'Sie müssen keine KI-Engineers suchen und einarbeiten. Wir liefern mit Teams in Deutschland und Polen, Sie bleiben das Gesicht zum Kunden, wenn Sie das möchten.',
  },
];

const models = [
  {
    label: 'Modell 1',
    title: 'Empfehlung',
    points: [
      'Sie stellen den Kontakt zu Ihrem Kunden her',
      'Wir übernehmen Angebot, Umsetzung und Gewährleistung',
      'Sie erhalten 10 % des Netto-Auftragswerts des ersten Projekts',
      'Hosting und Betrieb können bei Ihnen bleiben',
    ],
  },
  {
    label: 'Modell 2',
    title: 'White Label',
    points: [
      'Sie verkaufen unter Ihrem Namen und rechnen selbst ab',
      'Wir bauen als Ihr Engineering-Team im Hintergrund, zu Partnerkonditionen',
      'Sie behalten die Kundenbeziehung vollständig',
      'Konditionen vereinbaren wir pro Projekt schriftlich',
    ],
  },
];

const steps = [
  { number: '01', title: 'Kennenlernen', description: '30 Minuten: Ihre Kunden, Ihre Infrastruktur, welche KI-Anfragen Sie gerade bekommen.' },
  { number: '02', title: 'Modell festlegen', description: 'Empfehlung oder White Label, schriftlich vereinbart, mit NDA.' },
  { number: '03', title: 'Erster Kunde', description: 'Wir kommen als Ihr KI-Team mit in das erste Kundengespräch und starten mit dem Pilot.' },
];

const check = 'M5 13l4 4L19 7';

const breadcrumbs = [
  { label: 'Startseite', href: '/de/' },
  { label: 'Partner', href: '/de/partner' },
];
---

<Layout
  locale="de"
  title="KI-Partner für Systemhäuser, MSPs und Atlassian-Partner | Ironum"
  description="Ihre Kunden fragen nach KI, Sie haben kein KI-Team. Ironum baut selbst gehostete KI-Lösungen für Ihre Kunden: per Empfehlung mit 10 % Provision oder als White Label."
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <PageHero
    eyebrow="FÜR SYSTEMHÄUSER, MSPs UND ATLASSIAN-PARTNER"
    title="Ihre Kunden fragen nach KI. Wir bauen sie."
    subtitle="Ironum ist das KI-Engineering-Team für IT-Dienstleister: Sie bringen die Kundenbeziehung und die Infrastruktur, wir ein fertiges Angebot und Engineers, die es in Produktion bringen."
    ctaText="Partnergespräch anfragen"
    ctaLink={partnerCta}
  />

  <!-- Warum -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="max-w-3xl space-y-4">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">WARUM DAS FÜR SIE PASST</span>
        <h2 class="text-3xl md:text-5xl font-bold">KI-Projekte ohne eigenes KI-Team</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {reasons.map((r) => (
          <div class="border-2 border-gray-100 rounded-2xl p-6 md:p-8 flex flex-col">
            <h3 class="text-2xl font-bold mb-3">{r.title}</h3>
            <p class="text-gray-500 text-lg font-semibold">{r.description}</p>
            {r.source && <p class="text-gray-400 text-sm font-semibold mt-4">Quelle: <a href={r.source.href} target="_blank" rel="noopener" class="underline">{r.source.text}</a></p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Modelle -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="max-w-3xl space-y-4">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">ZUSAMMENARBEIT</span>
        <h2 class="text-3xl md:text-5xl font-bold">Zwei Modelle, Sie wählen pro Kunde</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {models.map((m) => (
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-6 md:p-8">
            <span class="text-blue-600 text-sm font-bold uppercase tracking-wider">{m.label}</span>
            <h3 class="text-3xl font-bold mt-2 mb-6">{m.title}</h3>
            <ul class="space-y-3">
              {m.points.map((p) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-green-500 mt-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} /></svg>
                  <span class="text-gray-700 text-lg font-medium">{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Angebot -->
  <section class="px-4 md:px-20 py-20 md:py-32">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-start">
      <div class="space-y-4">
        <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">WAS SIE ANBIETEN KÖNNEN</span>
        <h2 class="text-3xl md:text-5xl font-bold">Ein Einstieg, den Kunden leicht entscheiden</h2>
        <p class="text-gray-500 text-lg font-semibold">Ein klar begrenzter Pilot zum Festpreis senkt die Hürde beim Kunden. Danach folgt der Produktivbetrieb, ebenfalls zum Festpreis.</p>
        <p class="text-gray-500 text-lg font-semibold">Darüber hinaus bauen wir private Dokumentensuche, KI-Assistenten und Workflow-Automatisierung, jeweils auf Infrastruktur, die Sie oder Ihr Kunde kontrollieren.</p>
      </div>
      <a href="/de/dienstleistungen/jira-confluence-ki/" class="block border-2 border-blue-600 rounded-2xl p-6 md:p-8 hover:bg-gray-50 transition-colors no-underline">
        <p class="text-sm font-bold uppercase tracking-wider text-gray-500">Pilot · 2 Wochen · 4.900 € zzgl. MwSt.</p>
        <h3 class="text-2xl md:text-3xl font-bold mt-2 mb-3 text-gray-900">KI-Suche für Jira und Confluence, auf den Servern des Kunden</h3>
        <p class="text-gray-500 text-lg font-semibold">Für Kunden mit Atlassian Data Center, für die Rovo ohne Cloud-Plan nicht in Frage kommt. Mit Berechtigungen, Quellenlinks und schriftlicher Bewertung nach zwei Wochen.</p>
        <span class="inline-block mt-4 text-blue-600 font-semibold">Zum Angebot →</span>
      </a>
    </div>
  </section>

  <!-- Ablauf und Ansprechpartner -->
  <section class="px-4 md:px-20 py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-5 gap-12 items-start">
      <div class="lg:col-span-3 space-y-8">
        <div class="space-y-4">
          <span class="text-orange-500 font-semibold tracking-[0.2em] text-sm uppercase block">SO STARTEN WIR</span>
          <h2 class="text-3xl md:text-5xl font-bold">In drei Schritten zum ersten gemeinsamen Kunden</h2>
        </div>
        <div class="space-y-6">
          {steps.map((s) => (
            <div class="flex gap-5">
              <span class="text-blue-600 text-2xl font-bold shrink-0 w-10">{s.number}</span>
              <div>
                <h3 class="text-xl font-bold mb-1">{s.title}</h3>
                <p class="text-gray-500 text-lg font-semibold">{s.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="lg:col-span-2 bg-white border-2 border-gray-100 rounded-2xl p-6 md:p-8 space-y-4">
        <img src="/gerrit-halfmann.jpg" alt="Gerrit Halfmann, Gründer von Ironum" width="2296" height="2296" class="w-24 h-24 rounded-2xl object-cover" loading="lazy" />
        <div>
          <p class="text-xl font-bold">Gerrit Halfmann</p>
          <p class="text-gray-500 font-semibold">Gründer, Ironum</p>
        </div>
        <p class="text-gray-700 font-medium">Ironum ist ein Produkt der LearnSlice UG (haftungsbeschränkt) in Düsseldorf. Unser Team bringt mehr als 20 Jahre Erfahrung in individueller Softwareentwicklung mit.</p>
        <p class="text-gray-500 font-semibold"><a href="mailto:info@ironum.com" class="text-blue-600 hover:underline">info@ironum.com</a> · <a href="tel:+4915783914112" class="text-blue-600 hover:underline">+49 1578 3914112</a></p>
        <a href={partnerCta} class="inline-block w-full text-center bg-blue-600 text-white rounded-full px-6 py-3 font-medium text-lg hover:bg-blue-700 transition-all duration-200 min-h-[48px] touch-manipulation">Partnergespräch anfragen</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
